# Visibility Engine — environment variables
# Copy to .env.local for local dev. Never commit real values. Server-only unless prefixed NEXT_PUBLIC_.

# --- App ---
REPORT_BASE_URL=https://visibility.studio5.in   # base for public report links (/r/{token})
CAL_LINK=                                        # Cal.com booking link (admin Settings can override)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=                   # anon role has NO table access; used only for admin auth session

# --- Supabase (server) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=                       # server + Trigger.dev only

# --- Trigger.dev ---
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# --- Anthropic (LLM steps) ---
ANTHROPIC_API_KEY=
LLM_MODE=live                                    # live | mock (tests force mock)
LLM_MODEL_EXTRACT=claude-haiku-5-5
LLM_MODEL_CLASSIFY=claude-sonnet-5-5
LLM_MODEL_REASON=claude-opus-5-5

# --- Probe engines ---
ENGINE_MODE=live                                 # live | mock (tests force mock)
ENGINES_ENABLED=openai,perplexity                # add gemini only after build-plan Q1 is resolved
SAMPLES_PER_PROMPT=2

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_REASONING_EFFORT=low
OPENAI_SEARCH_CONTEXT_SIZE=medium
OPENAI_CONCURRENCY=4

PERPLEXITY_API_KEY=
PERPLEXITY_API_FLAVOR=agent                      # agent (/v1/agent) | sonar_legacy (/v1/sonar)
PERPLEXITY_MODEL=perplexity/sonar
PERPLEXITY_CONCURRENCY=1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_GROUNDING=true                            # see engines.md §3.5 before enabling
GEMINI_THINKING_LEVEL=LOW
GEMINI_CONCURRENCY=2

# --- Pipeline ---
CYCLE_REUSE_DAYS=14
CYCLE_START_DELAY=10m
MAX_CYCLE_COST_USD=30
BRAND_PROMPTS_PER_PROSPECT=4
ABSENCE_MAX_MENTIONS=0

# --- Page fetching ---
PAGE_FETCHER_FALLBACK=none                       # none | jina | firecrawl
JINA_API_KEY=
FIRECRAWL_API_KEY=

# --- Phase 2 (unused in Phase 1) ---
INSTANTLY_API_KEY=
INSTANTLY_WEBHOOK_SECRET=                        # shared secret sent as a custom header (Instantly has no HMAC signing)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
